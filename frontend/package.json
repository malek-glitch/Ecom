{
	"name": "liftoff-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:spa": "cross-env ADAPTER=static vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && npm run i18n:compile || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "svelte-kit sync && npm run i18n:compile && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint . && node scripts/check-rtl.mjs",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"gen:api": "node scripts/gen-api.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-arabic": "^5.3.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@inlang/plugin-m-function-matcher": "^2.2.16",
		"@inlang/plugin-message-format": "^4.4.4",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.50.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"bits-ui": "^2.19.4",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	}
}
