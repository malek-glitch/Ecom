# Copy to .env (or run `node scripts/init.mjs`, which also generates the secrets).
# Read by Docker Compose and by the backend (`./gradlew bootRun` imports this file).
# One KEY=value per line, no quotes, no comments after a value.
# Every variable is documented in docs/CONFIGURATION.md.

# --- App ---------------------------------------------------------------------
APP_NAME=Liftoff
# Public URL of the web app, used in email links. Dev server: http://localhost:5173
APP_URL=http://localhost:5173

# --- Database ----------------------------------------------------------------
POSTGRES_DB=liftoff
POSTGRES_USER=liftoff
POSTGRES_PASSWORD=liftoff-dev-password
DATABASE_URL=jdbc:postgresql://localhost:5432/liftoff
DATABASE_USER=liftoff
DATABASE_PASSWORD=liftoff-dev-password

# --- Auth --------------------------------------------------------------------
# At least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_REQUIRE_VERIFIED_EMAIL=true
# First administrator, created at startup while no admin exists.
ADMIN_EMAIL=admin@liftoff.local
ADMIN_PASSWORD=change-me-admin-password
# Google sign-in: OAuth "Web application" client id. Empty = button hidden.
GOOGLE_CLIENT_ID=

# --- Mail (Mailpit in dev: inbox at http://localhost:8025) ---------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=Liftoff <no-reply@liftoff.local>

# --- Object storage (optional: docker compose --profile storage up -d) --------
STORAGE_ENABLED=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=liftoff
STORAGE_ACCESS_KEY=liftoff
STORAGE_SECRET_KEY=liftoff-dev-secret
STORAGE_PUBLIC_BASE_URL=

# --- Misc ----------------------------------------------------------------------
# Only for clients on another origin (Capacitor: capacitor://localhost,https://localhost)
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
# Fill an empty catalog with demo products at startup. Keep it false in production.
SHOP_SEED_DEMO=true
